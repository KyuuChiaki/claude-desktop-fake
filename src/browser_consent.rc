#pragma code_page(65001)
#include <windows.h>
#include "browser_consent_ids.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_BROWSER_CONSENT DIALOGEX 0, 0, 340, 174
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOPMOST
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL "", IDC_BROWSER_LOGO, "Static", SS_ICON | SS_CENTERIMAGE | SS_REALSIZEIMAGE, 158, 16, 24, 24
    CONTROL "Claude 正在尝试使用浏览器打开链接", IDC_BROWSER_TITLE, "Static", SS_CENTER | SS_CENTERIMAGE, 18, 49, 304, 25
    CONTROL "", IDC_BROWSER_URL, "Edit", ES_CENTER | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 25, 87, 290, 29
    PUSHBUTTON    "确认", IDOK, 18, 135, 148, 24
    DEFPUSHBUTTON "拒绝", IDCANCEL, 174, 135, 148, 24
END
